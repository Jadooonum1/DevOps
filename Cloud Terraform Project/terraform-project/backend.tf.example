# Remote state. Copy to backend.tf, create the bucket once, then:  terraform init -migrate-state
# use_lockfile (Terraform >= 1.10) writes a .tflock object next to the state, so no DynamoDB table is needed.
terraform {
  backend "s3" {
    bucket       = "reader-web-tfstate"
    key          = "cloud-terraform-project/dev.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
