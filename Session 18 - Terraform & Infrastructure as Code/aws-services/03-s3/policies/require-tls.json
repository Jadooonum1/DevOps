{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyPlainHttp",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::bookshelf-covers", "arn:aws:s3:::bookshelf-covers/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
