# Source this before running any commands.sh:  source ../localstack.env
# LocalStack accepts any credentials; "test"/"test" is the convention.
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=us-east-1
export AWS_PAGER=""
export LOCALSTACK_URL="${LOCALSTACK_URL:-http://localhost:4566}"

# awsl = aws CLI pointed at LocalStack
awsl() { aws --endpoint-url "$LOCALSTACK_URL" "$@"; }
